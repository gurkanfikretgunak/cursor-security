# Copy to apps/web/.env.local

# Postgres (see docker-compose.yml at repo root). Production uses Render Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cursor_security
# DATABASE_SSL=false

# Render API (Vercel frontend talks to this over HTTPS)
BACKEND_URL=http://localhost:10000
NEXT_PUBLIC_BACKEND_URL=http://localhost:10000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-long-random-secret
AUTH_URL=http://localhost:3000
# Production test login (Vercel env). Leave unset locally.
# AUTH_TEST_PASSWORD=

# Magic-link sender identity
AUTH_EMAIL_FROM=noreply@localhost

# Optional SMTP (production). Without SMTP, links are logged to the server console in development.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
